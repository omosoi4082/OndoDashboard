# 중계 서버 포트 (운영 모드에서는 대시보드도 이 포트로 접속)
PORT=8080

# 센서 서버 (온도 제공). mock이면 픽스처 사용
SENSOR_MODE=live
# 현재·예측 모드 입력 이력(3시간, 환기팬)만 따로 mock/live 지정. 비우면 SENSOR_MODE를 따름
SENSOR_HISTORY_MODE=
SENSOR_BASE_URL=http://121.188.206.3:56752
# 연산 입력 중 센서 이력을 쓰는 항목(환기팬 가동률). 외기 온·습도(T_out·RH_out)는 기상청
# 초단기실황 최근 정시 4회에서 받는다(2026-10-13 B-3)
INPUT_FAN_PATH=JE/EX/NH/FN1/FAN1

# 기상청 단기예보 조회서비스 (공공데이터포털)
# 코드에서 URL 인코딩을 한다면 "Decoding" 키를 넣는다 (Encoding 키를 넣으면 이중 인코딩됨)
KMA_SERVICE_KEY=
# 농장 위경도 (격자 변환·일출일몰 계산). 격자: npm run grid -- <lat> <lon>
FARM_LAT=
FARM_LON=
KMA_NX=
KMA_NY=
# 헤더 위치 표시용 동네 이름(기상청 격자 KMA_NX·NY의 예보구역 이름, 예: 제주시 아라동)
FARM_AREA_NAME=

# 연산 서버. mock이면 MockComputeClient 사용, http면 실제 연산 서버 호출
COMPUTE_MODE=mock
# 연산 서버(로컬). 같은 PC/같은 공유기 미정이라 여기서 IP·포트 수정
# 같은 PC: http://localhost:포트, 같은 공유기: http://연산서버PC고정내부IP:포트
# 온도 사무실 1차 버전(2026-10-19~): http://192.168.10.91:9000 — 그 내부망에서만 접속되고,
# 중계 서버 PC의 내부 IP를 온도 측 허용 목록에 넣어야 한다(아니면 HTTP 403)
COMPUTE_BASE_URL=http://localhost:9000
# 기본 비움(로컬 구동). 비어 있으면 헤더를 보내지 않음
COMPUTE_API_KEY=
COMPUTE_API_KEY_HEADER=X-API-Key
# 예측 구간 fan_pct 5단 구간 표(docs/03 2장, 2026-10-13 B-4). 경계는 아래쪽 포함(24.0℃ → 60%)
# 22℃ 미만 20% / 22~24 40% / 24~26 60% / 26~28 80% / 28℃ 이상 100%
# FAN_STEP_PCTS는 FAN_STEP_TEMPS보다 1개 많게
FAN_STEP_TEMPS=22,24,26,28
FAN_STEP_PCTS=20,40,60,80,100

# 2D 단면 높이(m)
SECTION_Z_M=0.5

# 타임아웃 (ms)
UPSTREAM_TIMEOUT_MS=10000
COMPUTE_TIMEOUT_MS=60000
# 연산 서버가 SERVER·BUSY 오류를 주면 이만큼 기다렸다가 1회 재시도(BAD_REQUEST·타임아웃은 재시도 안 함).
# 연산 서버 상태 확인(GET /v1/health, /api/health에서 사용)은 UPSTREAM_TIMEOUT_MS를 쓴다
COMPUTE_RETRY_DELAY_MS=60000

# 상세 화면 고정 형상(포인트 좌표, grid·flowGrid 정의)
GEOMETRY_FILE=./config/geometry.json

# 전문가·제어 모드 목업 파일(mock/README.md). 온도 측 제공 파일 경로(서브폴더 없음).
# 파일이 없으면 해당 라우트만 오류 응답(서버는 계속 뜸).
MOCK_EXPERT_FILE=./mock/mock_expert.json
MOCK_CONTROL_FILE=./mock/mock_control.json

# 현재·예측 모드 목업 응답 파일(온도 측 2026-10-13 v3 제공). COMPUTE_MODE=mock일 때
# 연산 서버 대신 이 파일을 읽는다. 파일이 없거나 형식이 안 맞으면 합성 생성기로 폴백한다
# (화면이 뜨는지 확인하는 용도 — 시각이 입력에 맞춰 생성되고 range는 relay가 계산한다).
MOCK_RESPONSE_CURRENT_FILE=./mock/sample_response_current.json
MOCK_RESPONSE_FORECAST_FILE=./mock/sample_response_forecast.json

# 센서 5분 집계·결측 처리 (docs/03 1.2)
AGG_INTERP_MAX_GAP=3
AGG_ERROR_MIN_GAP=4
AGG_ERROR_MAX_RATIO=0.2
SENSOR_TEMP_MIN=-30
SENSOR_TEMP_MAX=50
SENSOR_RH_MIN=0
SENSOR_RH_MAX=100
SENSOR_FAN_MIN=0
SENSOR_FAN_MAX=100

# 기상청 단기예보가 아직 안 올라왔을 때(NO_DATA) 최신 발표분에서 최대 몇 단계 이전까지 내려갈지
# (발표 3시간 간격 — 3이면 23:00 → 20:00 → 17:00 → 14:00 = 최대 9시간 전 발표분)
# 2026-10-15 온도 측 확정: 3단계. 단기예보는 발표 시각부터 이틀 이상을 담아 9시간 전 발표분으로도
# 앞으로 24시간을 채울 수 있고, 화면이 비는 것보다 조금 이전 예보로라도 보여주는 편이 낫다.
KMA_VILAGE_MAX_STEPS_BACK=3

# 기상청 예보 결측 허용 시간(시간)
FORECAST_GAP_MAX_HOURS=3

# 전문가 모드 입력 범위(목업 단계 값, 05-open-questions.md #11 — 실제 연동 때 재확정)
EXPERT_TEMP_MIN=-30
EXPERT_TEMP_MAX=50
EXPERT_RH_MIN=0
EXPERT_RH_MAX=100
EXPERT_VENT_MIN=20
EXPERT_VENT_MAX=100
