# 중계 서버 포트 (운영 모드에서는 대시보드도 이 포트로 접속)
PORT=8080

# 센서 서버 (온도 제공). mock이면 픽스처 사용
SENSOR_MODE=live
# 현재·예측 모드 입력 이력(3시간)만 따로 mock/live 지정. 비우면 SENSOR_MODE를 따름
SENSOR_HISTORY_MODE=
SENSOR_BASE_URL=http://121.188.206.3:56752
# 연산 입력 출처 (T_out·RH_out는 외기로 가정, 확인 필요)
INPUT_T_OUT_PATH=JE/OU/WS/WS1/TEMP
INPUT_RH_OUT_PATH=JE/OU/WS/WS1/RH
INPUT_FAN_PATH=JE/EX/NH/FN1/FAN1

# 기상청 단기예보 조회서비스 (공공데이터포털)
# 코드에서 URL 인코딩을 한다면 "Decoding" 키를 넣는다 (Encoding 키를 넣으면 이중 인코딩됨)
KMA_SERVICE_KEY=
# 농장 위경도 (격자 변환·일출일몰 계산). 격자: npm run grid -- <lat> <lon>
FARM_LAT=
FARM_LON=
KMA_NX=
KMA_NY=
# 헤더 위치 표시용 동네 이름(기상청 격자 KMA_NX·NY의 예보구역 이름, 예: 제주시 아라동)
FARM_AREA_NAME=

# 연산 서버. mock이면 MockComputeClient 사용
COMPUTE_MODE=mock
# 연산 서버(로컬). 같은 PC/같은 공유기 미정이라 여기서 IP·포트 수정
# 같은 PC: http://localhost:포트, 같은 공유기: http://연산서버PC고정내부IP:포트
COMPUTE_BASE_URL=http://localhost:9000
# 기본 비움(로컬 구동). 비어 있으면 헤더를 보내지 않음
COMPUTE_API_KEY=
COMPUTE_API_KEY_HEADER=X-API-Key
# 예측 구간 fan_pct 계산식(docs/03 2장, summary 형식 폐기):
# fan_pct = clamp(FAN_MIN + (FAN_MAX-FAN_MIN)*(T_out-FAN_T_LOW)/(FAN_T_HIGH-FAN_T_LOW), FAN_MIN, FAN_MAX)
FAN_T_LOW=22
FAN_T_HIGH=30
FAN_MIN=20
FAN_MAX=100

# 2D 단면 높이(m)
SECTION_Z_M=0.5

# 타임아웃 (ms)
UPSTREAM_TIMEOUT_MS=10000
COMPUTE_TIMEOUT_MS=60000

# 상세 화면 고정 형상(포인트 좌표, grid·flowGrid 정의)
GEOMETRY_FILE=./config/geometry.json

# 전문가·제어 모드 목업 파일(mock/README.md). 온도 측 제공 파일 경로(서브폴더 없음).
# 파일이 없으면 해당 라우트만 오류 응답(서버는 계속 뜸).
MOCK_EXPERT_FILE=./mock/mock_expert.json
MOCK_CONTROL_FILE=./mock/mock_control.json

# 센서 5분 집계·결측 처리 (docs/03 1.2)
AGG_INTERP_MAX_GAP=3
AGG_ERROR_MIN_GAP=4
AGG_ERROR_MAX_RATIO=0.2
SENSOR_TEMP_MIN=-30
SENSOR_TEMP_MAX=50
SENSOR_RH_MIN=0
SENSOR_RH_MAX=100
SENSOR_FAN_MIN=0
SENSOR_FAN_MAX=100

# 기상청 예보 결측 허용 시간(시간)
FORECAST_GAP_MAX_HOURS=3

# 전문가 모드 입력 범위(목업 단계 값, 05-open-questions.md #11 — 실제 연동 때 재확정)
EXPERT_TEMP_MIN=-30
EXPERT_TEMP_MAX=50
EXPERT_RH_MIN=0
EXPERT_RH_MAX=100
EXPERT_VENT_MIN=20
EXPERT_VENT_MAX=100
